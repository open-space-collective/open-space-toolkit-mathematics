# Apache License 2.0

[build-system]
requires = ["setuptools"]
build-backend = "setuptools.build_meta"

[project]
name = "open-space-toolkit-mathematics"
version = "${PROJECT_VERSION_STRING}"
description = "Geometry, curve fitting, optimization."
authors = [
    {name = "Open Space Collective", email = "contact@open-space-collective.org"}
]
readme = "README.md"
license = "Apache-2.0"
keywords = ["open-space-collective", "open-space-toolkit", "mathematics"]
classifiers = [
    "Development Status :: 3 - Alpha",
    "Programming Language :: Python :: 3",
    "Operating System :: POSIX :: Linux",
]
requires-python = ">=3.9"

dependencies = [
    "open-space-toolkit-core~=5.0",

    "numpy~=2.0"
] 

[project.optional-dependencies]
prebuild = [
    "nanobind==2.9.2"
]
test = [
    "pytest"
]

[tool.setuptools]
zip-safe = true
include-package-data = true
# Declare a dummy extension module to force platform-specific wheel tags.
# The actual .so files are pre-compiled and included via package-data.
ext-modules = [
    {name = "ostk.mathematics._platform", sources = []}
]

[tool.setuptools.packages.find]
include = ["ostk.mathematics", "ostk.mathematics.*"]

[tool.setuptools.package-data]
"ostk.mathematics" = ["${SHARED_LIBRARY_TARGET}.${PROJECT_VERSION_MAJOR}", "${LIBRARY_TARGET}.*${EXTENSION}*.so", "*.pyi", "py.typed"]
"*" = ["*/data/*"]
